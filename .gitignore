.DS_Store

.env

# Xcode per-user state — window layout, editor selection, scheme ordering.
# Regenerated by Xcode on demand; not project data.
xcuserdata/
*.xcuserstate
xcshareddata/

# Swift Package Manager build products. Package.resolved is intentionally not
# committed: this package has no dependencies, and it is a library.
.build/
.swiftpm/
Package.resolved

# Left behind by running scripts/check_swift.py
__pycache__/
